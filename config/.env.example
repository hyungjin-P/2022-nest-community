# portfolio/mock: 더미 값만 둔다. 실제 값은 저장소에 두지 않는다.
# - 목업 모드(npm run start:mock, mock:db*)는 이 파일을 직접 읽는다. 복사할 필요 없다(셸 환경변수가 우선).
# - 원본 경로(npm run start/build)는 config/.env.development 를 읽는다(app.module.ts:25 고정) → 이 파일을 복사해 실제 값을 채운다.
NOW_STAGE = mock
CONFIG_NAME = keeping-user-api-mock

# Server Configs
SERVER_PORT = 3000

# Database Configs (목업 MySQL — MOCK.md 참고)
DATABASE_TYPE = mysql
DATABASE_PORT = 3307
DATABASE_SCHEMA = keeping_mock
DATABASE_HOST = 127.0.0.1
DATABASE_USERNAME = root
DATABASE_PASSWORD =
DATABASE_SYNCHRONIZE = false

# JWT Configs
JWT_EXPIRES_IN = 1800
JWT_ACCESS_SECRET = mock-access-secret
JWT_REFRESH_EXPIRES_IN = 14d
JWT_REFRESH_SECRET = mock-refresh-secret

# AWS SES Configs (목업 모드에서는 S3·SES 를 로컬 fake 로 바꾸므로 쓰이지 않는다)
AWS_SES_ACCESS_KEY_ID = mock-access-key-id
AWS_SES_SECRET_ACCESS_KEY = mock-secret-access-key
AWS_SES_REGION = ap-northeast-2
AWS_SES_FILEPATH = src

# Crypto Utils
UTILS_CRYPTO_PLAINTEXT = mock-crypto-passphrase

# Naver Login API (목업 모드에서는 요청이 나가지 않는다)
NAVER_LOGIN_GRANT_TYPE = authorization_code
NAVER_LOGIN_CLIENT_ID = mock-naver-client-id
NAVER_LOGIN_CLIENT_SECRET = mock-naver-client-secret
NAVER_LOGIN_API_URL = https://nid.naver.com/oauth2.0/token

# Kakao Login API
KAKAO_LOGIN_URL = https://kapi.kakao.com

# Domain Address
DOMAIN_WEB_ADDRESS = http://localhost:4200
